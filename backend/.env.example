# =====================================================================
# Emergency Shelter Allocation Platform — backend configuration
# Copy this file to backend/.env and adjust the values.
# Never commit the real .env file.
# =====================================================================

NODE_ENV=development
PORT=5000

# --------------------------- Database --------------------------------
# Either set DATABASE_URL (takes precedence) ...
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esap
# ... or the individual fields below.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=esap
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=10

# ----------------------------- Auth ----------------------------------
# REQUIRED. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ----------------------------- CORS ----------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------- Google Sign-In (OPTIONAL) -----------------------
# Leave blank to disable. When blank, GET /api/auth/config reports
# googleAuthEnabled:false and the frontend hides the Google button
# instead of showing a control that cannot work.
GOOGLE_CLIENT_ID=

# ------------- Administrator passkey (OPTIONAL, recommended) ---------
# When set, creating or logging into an administrator account requires
# this passkey as a second factor, matching the locked login design's
# "administrator verification" step. Leave blank during local evaluation
# to skip the extra step entirely.
ADMIN_PASSKEY=

# ---------------------- Routing (OPTIONAL) ---------------------------
# Public OSRM demo server used for real road routes on the map.
# If unreachable, the app falls back to an external OpenStreetMap
# directions link and tells the user — it never fabricates a route.
OSRM_BASE_URL=https://router.project-osrm.org

# ------------------ Seed credentials (OPTIONAL) ----------------------
# Override the demo accounts created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@esap.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=user@esap.local
SEED_USER_PASSWORD=User@12345
