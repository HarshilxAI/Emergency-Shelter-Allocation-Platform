# Base URL of the backend API.
# Leave as-is for local development: Vite proxies /api to localhost:5000.
VITE_API_URL=/api

# Public OSRM routing service used to draw real road routes on the map.
# If it cannot be reached the app says so and offers an external
# OpenStreetMap directions link instead of drawing a fabricated line.
VITE_OSRM_URL=https://router.project-osrm.org
